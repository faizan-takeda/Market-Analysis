{
  "name": "medicine-2040-executive-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive executive view over the MEDICINE 2040 research encyclopedia. All data is generated by ../scripts/build_app_data.py from the evidence registries; nothing is hardcoded.",
  "scripts": {
    "data": "python3 ../scripts/build_app_data.py",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node tests/data_integrity.test.mjs && node tests/render_smoke.mjs",
    "launch": "npm run data && npm run build && npm run test && npm run preview"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "marked": "^18.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
